 function buildPhotoUrl(filename) {
   if (!filename) {
@@ -10,7 +12,7 @@ function buildPhotoUrl(filename) {
   return `/photos/${encodeURIComponent(path.basename(filename))}`;
 }
 
-function buildPhotoThumbUrl(filename, width = LIST_THUMB_WIDTH) {
