Date: Mon, 24 Aug 2026 16:06:21 +0000
Subject: [PATCH] Add a public people embed API for synagogue memorial boards.

Sites can now fetch /s/:slug/api/people and render names, Hebrew dates, and cropped photo thumbnails without scraping the board HTML.
---
 app.js                    | 32 +++++++++++++++++++-
 lib/photo-url.js          | 32 +++++++++++++++++++-
 lib/public-board.js       | 62 +++++++++++++++++++++++++++++++++++++++
 test/public-board.test.js | 16 +++++++++-
 test/smoke.test.js        | 20 +++++++++++++
 5 files changed, 159 insertions(+), 3 deletions(-)

diff --git a/app.js b/app.js
index b8b7bb9..137a5c3 100644
--- a/app.js
+++ b/app.js
@@ -16,7 +16,7 @@ const mongoose = require('mongoose');
 const Synagogue = require('./models/Synagogue');
 const { loadSynagogueBoard } = require('./lib/load-synagogue-board');
 const { computeBoardVersion, slimBoardPayload } = require('./lib/board-payload');
-const { toPublicBoardPayload, toPublicPersonPayload } = require('./lib/public-board');
+const { toPublicBoardPayload, toPublicPersonPayload, toPublicPeoplePayload } = require('./lib/public-board');
 const { getJewishFeed } = require('./lib/jewish-feed');
 const { fetchWeatherForecast } = require('./lib/weather-api');
 const { applyBoardPreviewOverrides } = require('./lib/board-preview');
@@ -99,6 +99,18 @@ function hostnameFromHostHeader(hostHeader) {
   }
 }
 
+function publicRequestOrigin(req) {
+  const forwardedProto = String(req.get('X-Forwarded-Proto') || '')
+    .split(',')[0]
+    .trim();
+  const proto = forwardedProto || req.protocol || 'https';
+  const host = getRequestHost(req);
+  if (!host) {
+    return '';
+  }
+  return `${proto}://${host}`;
+}
+
 function requireSameOrigin(req, res, next) {
   if (!['POST', 'PUT', 'PATCH', 'DELETE'].includes(req.method)) {
     return next();
@@ -393,6 +405,24 @@ async function serveSynagogueFavicon(req, res, badge) {
   }
 }
 
+app.get('/s/:slug/api/people', apiRateLimiter, async (req, res) => {
+  try {
+    const synagogue = await loadSynagogueBoard(req.params.slug);
+
+    if (!synagogue) {
+      return res.status(404).json({ error: 'Synagogue not found' });
+    }
+
+    res.setHeader('Cache-Control', 'public, max-age=300');
+    return res.json(toPublicPeoplePayload(synagogue.people, {
+      origin: publicRequestOrigin(req),
+    }));
+  } catch (err) {
+    console.error('People payload error:', err);
+    return res.status(500).json({ error: publicErrorMessage(err) });
+  }
+});
+
 app.get('/s/:slug/api/board/version', apiRateLimiter, async (req, res) => {
   try {
     const synagogue = await loadSynagogueBoard(req.params.slug);
